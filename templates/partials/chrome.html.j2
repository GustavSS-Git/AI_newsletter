{% macro masthead(pub, root, edition=None) -%}
<header class="masthead">
  <h1 class="masthead__name"><a href="{{ root }}">{{ pub.name }}</a></h1>
  <p class="masthead__tagline">{{ pub.tagline }}</p>
  {% if edition %}
  <p class="dateline">
    <time datetime="{{ edition.date }}">{{ edition.date | long_date }}</time>
    <span class="dateline__sep">·</span>
    <span class="dateline__number">No. {{ edition.edition_number }}</span>
  </p>
  {% endif %}
</header>
{%- endmacro %}

{% macro footer(pub, root) -%}
<footer class="site-footer">
  <p>{{ pub.footer }}.</p>
  <p><a class="archive-link" href="{{ root }}archive/">Archive</a></p>
</footer>
{%- endmacro %}
