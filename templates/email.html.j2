{#- Email version of an edition. Inline styles only: most email clients ignore <style> blocks. -#}
{%- set ink = "#111111" -%}{%- set muted = "#555555" -%}{%- set rule = "#d8d4ca" -%}
{%- set serif = "Georgia, 'Times New Roman', serif" -%}
{%- macro sources(links) -%}
<p style="margin:8px 0 0;font-family:{{ serif }};font-size:13px;line-height:1.5;color:{{ muted }};">Sources:
{%- for l in links %} <a href="{{ l.url }}" style="color:{{ muted }};">{{ l.name }}</a>{% if not loop.last %},{% endif %}{% endfor %}</p>
{%- endmacro -%}
{%- macro story(s, lead=False) -%}
<tr><td style="padding:18px 0;border-bottom:1px solid {{ rule }};">
  <p style="margin:0;font-family:{{ serif }};font-size:11px;letter-spacing:1px;text-transform:uppercase;color:{{ muted }};">{{ s.category | category_label }}</p>
  <h2 style="margin:4px 0 8px;font-family:{{ serif }};font-size:{{ '26px' if lead else '20px' }};line-height:1.25;color:{{ ink }};font-weight:bold;">{{ s.headline }}</h2>
  <p style="margin:0;font-family:{{ serif }};font-size:17px;line-height:1.55;color:{{ ink }};">{{ s.summary }}</p>
  {%- if s.material == "headline_only" %}
  <p style="margin:6px 0 0;font-family:{{ serif }};font-size:13px;font-style:italic;color:{{ muted }};">Summary based on headlines only; open article text was not available.</p>
  {%- endif %}
  {{ sources(s.sources) }}
</td></tr>
{%- endmacro -%}
{%- macro brief_section(title, items) -%}
{%- if items %}
<tr><td style="padding:24px 0 4px;border-top:2px solid {{ ink }};">
  <p style="margin:0;font-family:{{ serif }};font-size:14px;letter-spacing:1px;text-transform:uppercase;color:{{ ink }};font-weight:bold;">{{ title }}</p>
</td></tr>
{%- for b in items %}
<tr><td style="padding:12px 0;border-bottom:1px solid {{ rule }};">
  <h3 style="margin:0 0 6px;font-family:{{ serif }};font-size:17px;line-height:1.3;color:{{ ink }};font-weight:bold;">{{ b.headline }}</h3>
  <p style="margin:0;font-family:{{ serif }};font-size:16px;line-height:1.5;color:{{ ink }};">{{ b.summary }}</p>
  {{ sources(b.sources) }}
</td></tr>
{%- endfor %}
{%- endif %}
{%- endmacro -%}
{#- Content block only: Buttondown wraps it in its own template (newsletter name, unsubscribe link).
    The local preview (newsletter/email.py: build_preview) adds a masthead around it. -#}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;">
  <tr><td align="center" style="padding-bottom:12px;border-bottom:3px double {{ ink }};">
    <p style="margin:0;font-family:{{ serif }};font-size:12px;letter-spacing:1px;text-transform:uppercase;color:{{ ink }};">{{ edition.date | long_date }} · No. {{ edition.edition_number }}</p>
  </td></tr>
  {{ story(edition.lead, lead=True) }}
  {%- for s in edition.main %}{{ story(s) }}{% endfor %}
  {{ brief_section("Europe", edition.europe_brief) }}
  {{ brief_section("Business & Finance", edition.finance_brief) }}
  <tr><td align="center" style="padding:28px 0 8px;font-family:{{ serif }};font-size:13px;line-height:1.6;color:{{ muted }};">
    {{ pub.footer }}.<br>
    <a href="{{ web_url }}" style="color:{{ muted }};">Read on the web</a> · <a href="{{ archive_url }}" style="color:{{ muted }};">Archive</a>
  </td></tr>
</table>
