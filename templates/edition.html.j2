{% extends "base.html.j2" %}
{% from "partials/story.html.j2" import story, brief %}
{% from "partials/chrome.html.j2" import masthead, footer %}

{% block title %}{{ pub.name }} — {{ edition.date | long_date }}{% endblock %}

{% block body %}
{{ masthead(pub, root, edition) }}

<main class="edition">
  {% if nav is defined and nav %}
  <nav class="edition-nav" aria-label="Edition navigation">
    {% if nav.prev %}<a class="edition-nav__prev" href="{{ nav.prev }}.html">← Previous</a>{% endif %}
    <a class="edition-nav__latest" href="{{ root }}">Latest</a>
    {% if nav.next %}<a class="edition-nav__next" href="{{ nav.next }}.html">Next →</a>{% endif %}
  </nav>
  {% endif %}

  <section class="lead" aria-label="Lead story">
    {{ story(edition.lead, lead=True) }}
  </section>

  {% if edition.main %}
  <section class="main-stories" aria-label="Top stories">
    {% for s in edition.main %}{{ story(s) }}{% endfor %}
  </section>
  {% endif %}

  {% if edition.europe_brief %}
  <section class="brief brief--europe" aria-labelledby="europe-h">
    <h2 id="europe-h" class="section-title">Europe</h2>
    {% for b in edition.europe_brief %}{{ brief(b) }}{% endfor %}
  </section>
  {% endif %}

  {% if edition.finance_brief %}
  <section class="brief brief--finance" aria-labelledby="finance-h">
    <h2 id="finance-h" class="section-title">Business &amp; Finance</h2>
    {% for b in edition.finance_brief %}{{ brief(b) }}{% endfor %}
  </section>
  {% endif %}

  {# v3: Week / Month / Year highlights #}
  <section class="highlights highlights--placeholder" aria-label="Highlights" hidden></section>

  {% if signup_action %}
  <section class="signup" aria-labelledby="signup-h">
    <h2 id="signup-h" class="section-title">Get it by email</h2>
    <p class="signup__text">One email each morning with the day's stories. Free; unsubscribe anytime.</p>
    <form class="signup__form" action="{{ signup_action }}" method="post" target="_blank">
      <label class="signup__label" for="signup-email">Email address</label>
      <input class="signup__input" id="signup-email" type="email" name="email" required autocomplete="email" placeholder="you@example.com">
      <input type="hidden" name="embed" value="1">
      <button class="signup__button" type="submit">Subscribe</button>
    </form>
    <p class="signup__note">You'll get an email to confirm your address.</p>
  </section>
  {% endif %}
</main>

{{ footer(pub, root) }}
{% endblock %}
