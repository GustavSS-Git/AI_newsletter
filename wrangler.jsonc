// Cloudflare Workers config: publishes the generated site/ folder as static assets, and a cron
// trigger that starts the daily GitHub Actions run on time (see worker/index.js).
// Cloudflare redeploys automatically on every push to main (Workers Builds, Git integration).
{
  "name": "ai-newsletter",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Keep Worker logs (incl. cron runs), so a failed 06:30 dispatch leaves its error message.
  "observability": {
    "enabled": true
  },
  "triggers": {
    // UTC. The worker dispatches only on the one that is 06:30 in Stockholm (04:30 CEST / 05:30 CET).
    "crons": ["30 4 * * *", "30 5 * * *"]
  }
}
