// Cloudflare Workers static-assets config: publishes the generated site/ folder as-is.
// Cloudflare redeploys automatically on every push to main (Workers Builds, Git integration).
{
  "name": "ai-newsletter",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  }
}
